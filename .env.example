# Frontend (safe to expose: the anon key is public by design; RLS protects data)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Edge Functions (set with: supabase secrets set NAME=value). NEVER put these in the frontend.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically on Supabase.
# Comma-separated list of allowed browser origins for the Edge Functions:
APP_ORIGINS=https://your-app.vercel.app
